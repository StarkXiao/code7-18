# ---- 通用 ----
NODE_ENV=development
APP_PORT=3000
APP_BASE_URL=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:5173
LOG_LEVEL=info
TZ=Asia/Shanghai

# ---- 数据库 ----
DATABASE_URL=postgresql://app:app@localhost:5432/uwb_mine?schema=public

# ---- 鉴权 ----
# 生产环境务必改成随机强密钥（≥32 位）
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ACCESS_TTL=900

# ---- 定位与告警规则（按需调优） ----
# 标签超过该秒数未上报 → 离线告警
PERSON_OFFLINE_AFTER_SEC=90
# 静止判定：3 米半径内持续 120 秒
STATIONARY_RADIUS_M=3
STATIONARY_AFTER_SEC=120
# 同类告警抑制窗口（秒）：窗口内重复触发只累加次数，不重复喊话
ALARM_DEDUP_WINDOW_SEC=300
# 告警未确认超过该秒数自动升级为 critical 并再次提醒
ALARM_ESCALATE_AFTER_SEC=300
# 低电量阈值（%）；恢复到阈值+5% 才解除，带迟滞防抖
LOW_BATTERY_PERCENT=15
INGEST_MAX_BATCH=500

# ---- 广播联动 ----
# console：日志输出（默认，演示用）；webhook：POST 到矿上 IP 广播主机
BROADCAST_DRIVER=console
BROADCAST_WEBHOOK_URL=
BROADCAST_TIMEOUT_MS=5000

# ---- worker 扫描周期（秒） ----
SCAN_INTERVAL_SEC=10

# ---- 模拟器（npm run simulate） ----
# SIM_API_BASE=http://localhost:3000/api/v1
# INGEST_KEY=uwb_dev_ingest_key_change_me_in_production_0001
