# ── 服务 ──────────────────────────────────────────────────────────────────
HTTP_PORT=8090

# ── UWB 定位引擎接入（UDP JSON 数据报）────────────────────────────────────
# 报文：{"tagId":"T001","x":12.4,"y":88.1,"z":0,"ts":1716000000000}
# 批量：{"positions":[{...},{...}]}
UWB_UDP_ENABLED=true
UWB_UDP_PORT=5005

# ── 检测参数 ──────────────────────────────────────────────────────────────
DETECT_INTERVAL_MS=1000        # 检测循环周期
STATIONARY_THRESHOLD_SEC=30    # 长时静止告警阈值
STATIONARY_RADIUS_M=1.5        # 静止锚点位移半径（米），超过即重新计时（抗 UWB 抖动）
STATIONARY_WINDOW_SEC=15       # 历史轨迹保留窗口（仅用于大屏回放）
OFFLINE_THRESHOLD_SEC=15       # 信号丢失告警阈值（秒）

# ── 告警与广播 ────────────────────────────────────────────────────────────
ALARM_REPEAT_INTERVAL_SEC=20   # 未确认高危告警重复广播间隔（秒）；确认后立即停止
ALARM_HISTORY_LIMIT=500

# 广播渠道（逗号分隔）：
#   console  服务端声光控制台（对应生产 IP 广播主机 SDK）
#   sse      推调度大屏（语音合成 + WebAudio 警笛）
#   webhook  第三方调度平台 / 综合自动化系统（POST JSON，失败自动重试）
BROADCAST_CHANNELS=console,sse
BROADCAST_WEBHOOK_URL=
BROADCAST_WEBHOOK_TIMEOUT_MS=3000
BROADCAST_WEBHOOK_RETRIES=2

# ── 内置模拟源（无真实定位引擎时演示/演练用）──────────────────────────────
SIMULATOR_ENABLED=true
SIMULATOR_NOISE_M=0.2          # 模拟 UWB 测量噪声（米，1σ）
SIMULATOR_REPORT_INTERVAL_MS=1000

# ── 数据持久化 ────────────────────────────────────────────────────────────
# DATA_FILE=data/state.json
